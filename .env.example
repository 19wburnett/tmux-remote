# claude-remote configuration
# Copy to ~/.claude-remote/env and edit. Loaded by run.sh and the systemd service.

# --- server ---
HOST=0.0.0.0
PORT=8787

# --- auth (REQUIRED: change the password) ---
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme
# Optional. If unset, a persistent random secret is generated in the data dir.
# AUTH_SECRET=

# --- data ---
# DATA_DIR=/home/YOU/.claude-remote/data
# LOG_DIR=/home/YOU/.claude-remote/data/logs

# --- tmux ---
# Only needed if you run tmux with a named socket or non-default path.
# TMUX_SOCKET=name
# TMUX_SOCKET_PATH=/path/to/socket

# --- behavior ---
# Poll interval for tmux in ms (default 1000).
# POLL_MS=1000
# Discover git branch/worktree/project automatically (default true).
# DISCOVER_GIT=true
# Response text injected when you Approve / Reject an [APPROVAL_REQUIRED] prompt.
AGENT_APPROVE_RESPONSE=y
AGENT_REJECT_RESPONSE=n
# How many transcript lines to keep per session (default 3000).
# RING_BUFFER_SIZE=3000

# --- dev ---
# NODE_ENV=development
